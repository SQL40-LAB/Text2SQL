# OpenAI API 키 (필수 — 모의 모드가 아닐 때)
OPENAI_API_KEY=sk-your-api-key-here

# 사용할 모델 (선택)
OPENAI_MODEL=gpt-4o-mini

# SQL 방언 (생성·검증 기본: oracle → 실행 시 MariaDB/MySQL로 변환)
SQL_DIALECT=oracle

# --- 로컬 MariaDB 연결 ---
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
MARIADB_DATABASE=hr

# 조회 결과 그리드: 한 페이지당 최대 행 수
QUERY_PAGE_SIZE=100
